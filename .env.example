# .env.example — CiberWebScan environment variables
# Copy this file to `.env` and update values for your environment.
# IMPORTANT: Do NOT commit your real `.env` file (secrets, API keys, credentials).
#
# NOTE ABOUT BEHAVIOR:
# The `ConfigLoader` resolves `CIBERWEBSCAN_` env vars against the configuration
# schema, so fields containing underscores (e.g. `command_injection`,
# `max_attempts`, `requests_per_second`) are supported directly. If a name is
# ambiguous, use double underscores (`__`) to mark section boundaries:
#   CIBERWEBSCAN_HTTP__RATE_LIMIT__REQUESTS_PER_SECOND -> http.rate_limit.requests_per_second
#
# -----------------------------------------------------------------------------
# Supported environment overrides
# -----------------------------------------------------------------------------
# Logging / runtime
LOG_LEVEL=INFO
CIBERWEBSCAN_LOGGING_LEVEL=INFO   # -> logging.level

# HTTP client / proxies
CIBERWEBSCAN_HTTP_TIMEOUT_CONNECT=10.0        # -> http.timeout.connect
CIBERWEBSCAN_HTTP_TIMEOUT_READ=30.0           # -> http.timeout.read
CIBERWEBSCAN_HTTP_PROXY_ROTATE=false          # -> http.proxy.rotate
CIBERWEBSCAN_HTTP_RETRY_MAX_ATTEMPTS=3        # -> http.retry.max_attempts
CIBERWEBSCAN_HTTP_RATE_LIMIT_ADAPTIVE=true    # -> http.rate_limit.adaptive
# Use standard proxy env vars for proxy URLs
HTTP_PROXY=http://proxy.example.com:3128
HTTPS_PROXY=http://proxy.example.com:3128
NO_PROXY=localhost,127.0.0.1

# Playwright / Scraping
CIBERWEBSCAN_SCRAPING_DYNAMIC_ENABLED=false   # -> scraping.dynamic.enabled
CIBERWEBSCAN_SCRAPING_DYNAMIC_HEADLESS=true   # -> scraping.dynamic.headless
CIBERWEBSCAN_SCRAPING_DYNAMIC_WAIT_TIMEOUT=10.0  # -> scraping.dynamic.wait_timeout

# Attack (safety)
CIBERWEBSCAN_ATTACK_ENABLED=false             # -> attack.enabled
# Individual attack flags map to their config fields, including those with
# underscores:
# CIBERWEBSCAN_ATTACK_XSS=false               # -> attack.xss
# CIBERWEBSCAN_ATTACK_SQLI=false              # -> attack.sqli
# CIBERWEBSCAN_ATTACK_CSRF=false              # -> attack.csrf
# CIBERWEBSCAN_ATTACK_SUBDOMAIN=false         # -> attack.subdomain
# CIBERWEBSCAN_ATTACK_COMMAND_INJECTION=false # -> attack.command_injection
# CIBERWEBSCAN_ATTACK_MAX_PAYLOADS=50         # -> attack.max_payloads
# CIBERWEBSCAN_ATTACK_USER_CONSENT=false      # -> attack.user_consent

# Cache
CIBERWEBSCAN_CACHE_ENABLED=true               # -> cache.enabled

# Analysis / CVE API keys
# NVD_API_KEY / VULNERS_API_KEY are read directly by the CVE clients, or use:
# CIBERWEBSCAN_ANALYSIS_CVE_NVD_API_KEY=...
# CIBERWEBSCAN_ANALYSIS_CVE_VULNERS_API_KEY=...

# -----------------------------------------------------------------------------
# Tips
# -----------------------------------------------------------------------------
# - Edit this file and save it as `.env` in the project root for local development.
# - Environment variables override values from `~/.ciberwebscan/config.yaml`.
# - For debugging set: LOG_LEVEL=DEBUG
# - Do NOT commit `.env` containing secrets or API keys to git.
# -----------------------------------------------------------------------------
