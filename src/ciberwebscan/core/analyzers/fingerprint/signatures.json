{
  "_comment": "This file contains signatures for identifying various web technologies.",
  "cms_signatures": {
    "Ghost": {
      "headers": [
        ["x-powered-by", "Ghost"],
        ["x-ghost-request-id", ""]
      ],
      "meta_tags": ["generator"],
      "content_patterns": ["ghost", "ghost-admin", "ghost\\/assets"],
      "script_patterns": ["ghost-sdk", "ghost\\/public"]
    },
    "Shopify": {
      "headers": [
        ["x-shopid", ""],
        ["x-shopify-stage", ""],
        ["x-shopify-shop", ""]
      ],
      "content_patterns": [
        "shopify",
        "cdn\\.shopify\\.com",
        "shopify_\\w+",
        "checkout\\.shopify\\.com"
      ],
      "script_patterns": [
        "shopify\\.js",
        "shopify_common\\.js",
        "shopify_digital_download"
      ]
    },
    "WordPress": {
      "headers": [
        ["x-powered-by", "WordPress"],
        ["link", ".*?<([^>]+)>; rel=\\\"https://api\\.w\\.org/\\\""]
      ],
      "meta_tags": ["generator"],
      "version_patterns": [
        "WordPress ([0-9.]+)",
        "wp-includes/js/dist/([0-9.]+)/",
        "wp-includes/js/tinymce[\\s\\\"]+([0-9.]+)",
        "wp-includes/js/jquery/jquery-migrate\\.min\\.js\\?ver=([0-9.]+)",
        "wp-includes/js/jquery/jquery\\.js\\?ver=([0-9.]+)",
        "wp-includes/css/dist/block-library/style\\.min\\.css\\?ver=([0-9.]+)",
        "wp-content/themes/twenty[^/]+/style\\.css.*?Version: ([0-9.]+)",
        "wp-content/plugins/akismet/_inc/.*?ver=([0-9.]+)"
      ],
      "content_patterns": [
        "wp-content",
        "wp-includes",
        "wp-admin",
        "wordpress",
        "wp-json",
        "wp-content/plugins/",
        "wp-content/themes/"
      ],
      "script_patterns": [
        "wp-content/themes/",
        "wp-content/plugins/",
        "wp\\.js",
        "wp-includes/js/"
      ]
    },
    "Drupal": {
      "headers": [
        ["x-generator", "Drupal ([0-9]+)\\s*\\([^)]+\\)"],
        ["x-drupal-cache-tags", ""]
      ],
      "meta_tags": ["generator"],
      "version_patterns": [
        "Drupal ([0-9]+)\\s*\\([^)]+\\)",
        "Drupal ([0-9.]+)",
        "misc/drupal\\.js\\?([0-9a-z]+)",
        "core/misc/drupal\\.js\\?([0-9a-z]+)",
        "sites/all/modules/.*?\\.info\\.yml.*?version:\\s*([0-9.]+)",
        "core/misc/drupal\\.settings.*?\"ajaxPageState\":\\\"([^\\\"]+)\\\","
      ],
      "content_patterns": [
        "drupal",
        "sites/default",
        "modules/",
        "themes/",
        "core/misc/drupal\\.js",
        "core/assets/vendor"
      ],
      "script_patterns": [
        "drupal\\.js",
        "misc/drupal",
        "core/misc/drupal",
        "core/assets/vendor"
      ]
    },
    "Joomla": {
      "headers": [
        ["x-content-encoded-by", "Joomla!"],
        ["x-powered-by", "Joomla! ([0-9.]+)"]
      ],
      "meta_tags": ["generator"],
      "version_patterns": [
        "Joomla! ([0-9.]+)",
        "Joomla!_([0-9.]+)",
        "media/system/js/mootools-core\\.js\\?([0-9a-f]+)",
        "media/jui/js/jquery\\.min\\.js\\?([0-9a-f]+)",
        "media/system/js/core\\.js\\?([0-9a-f]+)",
        "templates/.*?/css/template\\.css\\?([0-9a-f]+)",
        "media/system/css/system\\.css\\?([0-9a-f]+)",
        "media/jui/css/bootstrap\\.min\\.css\\?([0-9a-f]+)"
      ],
      "content_patterns": [
        "joomla",
        "components/",
        "modules/",
        "plugins/",
        "media/system/",
        "media/jui/"
      ],
      "script_patterns": [
        "media/system/js/",
        "media/jui/js/",
        "media/system/js/mootools-core\\.js",
        "media/jui/js/jquery\\.min\\.js",
        "media/system/js/core\\.js"
