    "Astro": {
      "content_patterns": ["astro-island", "astro:page", "astro:html"],
      "script_patterns": ["astro\\.js", "astro-"]
    },
    "Laravel": {
      "headers": [["x-powered-by", "Laravel"]],
      "content_patterns": ["laravel", "csrf-token", "_token"]
    },
    "Django": {
      "headers": [["x-framework", "Django"]],
      "content_patterns": ["csrfmiddlewaretoken", "__admin__", "static/admin/"]
    },
    "Rails": {
      "headers": [["x-powered-by", "Ruby on Rails"]],
      "content_patterns": ["rails", "csrf-token", "actionpack"]
    },
    "Express.js": {
      "headers": [["x-powered-by", "Express"]],
      "content_patterns": ["express", "node_modules"]
    },
    "ASP.NET": {
