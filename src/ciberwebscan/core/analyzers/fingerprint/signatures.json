        "org\\.springframework",
        "springframework"
      ],
      "script_patterns": [
        "spring\\.js",
        "spring-version: ([\\d.]+)",
        "spring-([\\d.]+)"
      ]
    },
    "Next.js": {
      "content_patterns": [
        "__next",
        "next/dist",
        "next/static",
        "_next/static"
