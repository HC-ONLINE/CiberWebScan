    "Magento": {
      "headers": [
        ["x-powered-by", "Magento"],
        ["x-magento-cache-control", ""],
        ["x-magento-cache-debug", ""],
        ["x-magento-debug", ""]
      ],
      "meta_tags": ["generator"],
      "version_patterns": [
        "Magento_([0-9._]+)",
        "Magento\\\\s*([0-9.]+)",
        "mage/cookies\\.js\\?([0-9a-f]+)",
        "js/prototype/prototype\\.js\\?([0-9a-f]+)",
        "skin/frontend/.*?/css/styles-m\\.css\\?([0-9a-f]+)",
        "Magento_Theme/template/.*?\\.phtml"
      ],
      "content_patterns": ["magento", "media/", "skin/", "app/"],
      "script_patterns": ["js/mage/", "prototype/"]
    }
  },
  "framework_signatures": {
    "Ruby on Rails": {
      "headers": [
        ["x-powered-by", "Ruby on Rails"],
        ["x-request-id", ""],
        ["x-runtime", ""]
      ],
      "content_patterns": [
        "<meta name=\"csrf-param\" content=\"authenticity_token\"",
        "data-turbo=\"true\"",
        "rails-ujs"
      ],
      "script_patterns": ["rails-ujs", "actioncable", "activestorage"]
    },
    "Spring": {
      "headers": [
        ["x-application-context", ""],
        ["x-powered-by", "Spring"]
      ],
      "content_patterns": [
